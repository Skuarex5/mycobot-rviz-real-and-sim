<?xml version="1.0"?>
<!-- Geometry from ../mycobot_280_m5/mycobot_280_m5_adaptive_gripper.urdf. Masses, inertias, friction and tool frame are nominal estimates, NOT calibrated hardware data. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="adaptive_gripper" params="parent">
    <link name="gripper_base">
      <visual>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_base.dae" />
        </geometry>
        <origin xyz="0.0 0 -0.012 " rpy=" 0 0 0" />
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_base.dae" />
        </geometry>
        <origin xyz="0.0 0 -0.012 " rpy=" 0 0 0" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.08" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <link name="gripper_left1">
      <visual>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_left1.dae" />
        </geometry>
        <origin xyz="0.039 -0.0133 -0.012 " rpy=" 0 0 0" />
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_left1.dae" />
        </geometry>
        <origin xyz="0.039 -0.0133 -0.012 " rpy=" 0 0 0" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <link name="gripper_left2">
      <visual>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_left2.dae" />
        </geometry>
        <origin xyz="0.005 -0.0195 -0.012 " rpy=" 0 0 0" />
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_left2.dae" />
        </geometry>
        <origin xyz="0.005 -0.0195 -0.012 " rpy=" 0 0 0" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <link name="gripper_left3">
      <visual>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_left3.dae" />
        </geometry>
        <origin xyz="0.012 0.0025 -0.012 " rpy=" 0 0 0" />
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_left3.dae" />
        </geometry>
        <origin xyz="0.012 0.0025 -0.012 " rpy=" 0 0 0" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <link name="gripper_right1">
      <visual>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_right1.dae" />
        </geometry>
        <origin xyz="-0.039 -0.0133 -0.012 " rpy=" 0 0 0" />
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_right1.dae" />
        </geometry>
        <origin xyz="-0.039 -0.0133 -0.012 " rpy=" 0 0 0" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <link name="gripper_right2">
      <visual>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_right2.dae" />
        </geometry>
        <origin xyz="-0.005 -0.0195 -0.012 " rpy=" 0 0 0" />
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_right2.dae" />
        </geometry>
        <origin xyz="-0.005 -0.0195 -0.012 " rpy=" 0 0 0" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <link name="gripper_right3">
      <visual>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_right3.dae" />
        </geometry>
        <origin xyz="-0.012 0.0025 -0.012 " rpy=" 0 0 0" />
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/urdf/adaptive_gripper/gripper_right3.dae" />
        </geometry>
        <origin xyz="-0.012 0.0025 -0.012" rpy=" 0 0 0" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <joint name="joint6output_to_gripper_base" type="fixed">
      <parent link="${parent}" />
      <child link="gripper_base" />
      <origin xyz="0 0 0.034" rpy="1.579 0 0" />
    </joint>
    <joint name="gripper_controller" type="revolute">
      <axis xyz="0 0 1" />
      <limit effort="10.0" lower="-0.5" upper="0.15" velocity="0.5" />
      <parent link="gripper_base" />
      <child link="gripper_left3" />
      <origin xyz="-0.012 0.005 0" rpy="0 0 0" />
      <dynamics damping="0.05" friction="0.01" />
    </joint>
    <joint name="gripper_base_to_gripper_left2" type="revolute">
      <axis xyz="0 0 1" />
      <limit effort="10.0" lower="-0.8" upper="0.5" velocity="0.5" />
      <parent link="gripper_base" />
      <child link="gripper_left2" />
      <origin xyz="-0.005 0.027 0" rpy="0 0 0" />
      <mimic joint="gripper_controller" multiplier="1.0" offset="0" />
      <dynamics damping="0.05" friction="0.01" />
    </joint>
    <joint name="gripper_left3_to_gripper_left1" type="revolute">
      <axis xyz="0 0 1" />
      <limit effort="10.0" lower="-0.5" upper="0.5" velocity="0.5" />
      <parent link="gripper_left3" />
      <child link="gripper_left1" />
      <origin xyz="-0.027 0.016 0" rpy="0 0 0" />
      <mimic joint="gripper_controller" multiplier="-1.0" offset="0" />
      <dynamics damping="0.05" friction="0.01" />
    </joint>
    <joint name="gripper_base_to_gripper_right3" type="revolute">
      <axis xyz="0 0 1" />
      <limit effort="10.0" lower="-0.15" upper="0.7" velocity="0.5" />
      <parent link="gripper_base" />
      <child link="gripper_right3" />
      <origin xyz="0.012 0.005 0" rpy="0 0 0" />
      <mimic joint="gripper_controller" multiplier="-1.0" offset="0" />
      <dynamics damping="0.05" friction="0.01" />
    </joint>
    <joint name="gripper_base_to_gripper_right2" type="revolute">
      <axis xyz="0 0 1" />
      <limit effort="10.0" lower="-0.5" upper="0.8" velocity="0.5" />
      <parent link="gripper_base" />
      <child link="gripper_right2" />
      <origin xyz="0.005 0.027 0" rpy="0 0 0" />
      <mimic joint="gripper_controller" multiplier="-1.0" offset="0" />
      <dynamics damping="0.05" friction="0.01" />
    </joint>
    <joint name="gripper_right3_to_gripper_right1" type="revolute">
      <axis xyz="0 0 1" />
      <limit effort="10.0" lower="-0.5" upper="0.5" velocity="0.5" />
      <parent link="gripper_right3" />
      <child link="gripper_right1" />
      <origin xyz="0.027 0.016 0" rpy="0 0 0" />
      <mimic joint="gripper_controller" multiplier="1.0" offset="0" />
      <dynamics damping="0.05" friction="0.01" />
    </joint>
    <link name="gripper_tool_frame" />
    <joint name="gripper_tool_frame_joint" type="fixed">
      <parent link="gripper_base" />
      <child link="gripper_tool_frame" />
      <origin xyz="0 0.06 0" rpy="0 0 0" />
    </joint>
    <!-- Collision graph matches the reviewed SRDF: permanently contacting
         linkage pairs are excluded, opposite fingertips remain enabled.
         Each link also has a unique bit so external default-mask objects
         and arm links still collide with every gripper part. -->
    <gazebo reference="gripper_base">
      <collision>
        <surface>
          <contact><collide_bitmask>0x0100</collide_bitmask></contact>
        </surface>
      </collision>
      <selfCollide>true</selfCollide>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
    <gazebo reference="gripper_left1">
      <collision>
        <surface>
          <contact><collide_bitmask>0x0207</collide_bitmask></contact>
        </surface>
      </collision>
      <selfCollide>true</selfCollide>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
    <gazebo reference="gripper_left2">
      <collision>
        <surface>
          <contact><collide_bitmask>0x0438</collide_bitmask></contact>
        </surface>
      </collision>
      <selfCollide>true</selfCollide>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
    <gazebo reference="gripper_left3">
      <collision>
        <surface>
          <contact><collide_bitmask>0x08c0</collide_bitmask></contact>
        </surface>
      </collision>
      <selfCollide>true</selfCollide>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
    <gazebo reference="gripper_right1">
      <collision>
        <surface>
          <contact><collide_bitmask>0x1049</collide_bitmask></contact>
        </surface>
      </collision>
      <selfCollide>true</selfCollide>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
    <gazebo reference="gripper_right2">
      <collision>
        <surface>
          <contact><collide_bitmask>0x2092</collide_bitmask></contact>
        </surface>
      </collision>
      <selfCollide>true</selfCollide>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
    <gazebo reference="gripper_right3">
      <collision>
        <surface>
          <contact><collide_bitmask>0x4024</collide_bitmask></contact>
        </surface>
      </collision>
      <selfCollide>true</selfCollide>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:macro name="adaptive_gripper_control" params="">
    <joint name="gripper_controller">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="gripper_base_to_gripper_left2">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="gripper_left3_to_gripper_left1">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="gripper_base_to_gripper_right3">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="gripper_base_to_gripper_right2">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="gripper_right3_to_gripper_right1">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
  </xacro:macro>
</robot>
