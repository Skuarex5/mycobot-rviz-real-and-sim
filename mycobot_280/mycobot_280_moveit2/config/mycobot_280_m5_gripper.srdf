<?xml version="1.0"?>
<robot name="mycobot_280_m5">
  <group name="arm_group">
    <chain base_link="g_base" tip_link="gripper_tool_frame" />
  </group>
  <group_state name="init_pose" group="arm_group">
    <joint name="joint2_to_joint1" value="0.0" />
    <joint name="joint3_to_joint2" value="0.0" />
    <joint name="joint4_to_joint3" value="0.0" />
    <joint name="joint5_to_joint4" value="0.0" />
    <joint name="joint6_to_joint5" value="0.0" />
    <joint name="joint6output_to_joint6" value="0.0" />
  </group_state>
  <group_state name="home" group="arm_group">
    <joint name="joint2_to_joint1" value="0.0" />
    <joint name="joint3_to_joint2" value="0.0" />
    <joint name="joint4_to_joint3" value="0.0" />
    <joint name="joint5_to_joint4" value="0.0" />
    <joint name="joint6_to_joint5" value="0.0" />
    <joint name="joint6output_to_joint6" value="0.0" />
  </group_state>
  <group_state name="ready" group="arm_group">
    <joint name="joint2_to_joint1" value="0.0" />
    <joint name="joint3_to_joint2" value="-0.4" />
    <joint name="joint4_to_joint3" value="-0.5" />
    <joint name="joint5_to_joint4" value="-0.2" />
    <joint name="joint6_to_joint5" value="0.0" />
    <joint name="joint6output_to_joint6" value="0.0" />
  </group_state>
  <disable_collisions link1="g_base" link2="joint1" reason="Adjacent" />
  <disable_collisions link1="g_base" link2="joint2" reason="Never" />
  <disable_collisions link1="g_base" link2="joint3" reason="Never" />
  <disable_collisions link1="joint1" link2="joint2" reason="Adjacent" />
  <disable_collisions link1="joint2" link2="joint3" reason="Adjacent" />
  <disable_collisions link1="joint3" link2="joint4" reason="Adjacent" />
  <disable_collisions link1="joint4" link2="joint5" reason="Adjacent" />
  <disable_collisions link1="joint5" link2="joint6" reason="Adjacent" />
  <disable_collisions link1="joint5" link2="joint6_flange" reason="Never" />
  <disable_collisions link1="joint6" link2="joint6_flange" reason="Adjacent" />
  <group name="gripper_group">
    <joint name="gripper_controller" />
  </group>
  <group_state name="open" group="gripper_group">
    <joint name="gripper_controller" value="0.15" />
  </group_state>
  <group_state name="closed" group="gripper_group">
    <joint name="gripper_controller" value="-0.5" />
  </group_state>
  <end_effector name="adaptive_gripper" parent_link="gripper_tool_frame" group="gripper_group" parent_group="arm_group" />
  <disable_collisions link1="joint6_flange" link2="gripper_base" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="gripper_left3" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="gripper_left2" reason="Adjacent" />
  <disable_collisions link1="gripper_left3" link2="gripper_left1" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="gripper_right3" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="gripper_right2" reason="Adjacent" />
  <disable_collisions link1="gripper_right3" link2="gripper_right1" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="gripper_left1" reason="Default" />
  <disable_collisions link1="gripper_base" link2="gripper_right1" reason="Default" />
  <disable_collisions link1="gripper_left1" link2="gripper_left2" reason="Default" />
  <disable_collisions link1="gripper_right1" link2="gripper_right2" reason="Default" />
  <!-- Mesh-only sub-millimeter overlap of the two central linkage members,
       observed across the permitted range; fingertips remain collision checked. -->
  <disable_collisions link1="gripper_left3" link2="gripper_right3" reason="Default"/>
  <!-- Same-side parallel linkage members meet at the shared jaw mechanism;
       mesh tessellation produces intermittent contact near the closed endpoint. -->
  <disable_collisions link1="gripper_left3" link2="gripper_left2" reason="Default"/>
  <disable_collisions link1="gripper_right3" link2="gripper_right2" reason="Default"/>
</robot>
