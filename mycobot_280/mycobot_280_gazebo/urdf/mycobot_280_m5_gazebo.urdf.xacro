<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_280_m5">

  <xacro:arg name="adaptive_gripper" default="false"/>
  <xacro:arg name="control_namespace" default=""/>
  <xacro:arg name="controller_params" default=""/>
  <xacro:include filename="$(find mycobot_description)/urdf/adaptive_gripper/adaptive_gripper.xacro"/>
  <xacro:if value="$(arg adaptive_gripper)">
    <xacro:adaptive_gripper parent="joint6_flange"/>
  </xacro:if>

  <link name="world"/>

  <joint name="world_to_g_base" type="fixed">
    <parent link="world"/>
    <child link="g_base"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="g_base">
    <visual>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/G_base.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/G_base.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <link name="joint1">
    <visual>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint1.dae"/>
      </geometry>
      <origin xyz="0.0 0 0" rpy="0 0 -1.5708"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint1.dae"/>
      </geometry>
      <origin xyz="0.0 0 0" rpy="0 0 -1.5708"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <link name="joint2">
    <visual>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint2.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint2.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <link name="joint3">
    <visual>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint3.dae"/>
      </geometry>
      <origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint3.dae"/>
      </geometry>
      <origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/>
    </collision>
    <inertial>
      <origin xyz="-0.05 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.0004"/>
    </inertial>
  </link>

  <link name="joint4">
    <visual>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint4.dae"/>
      </geometry>
      <origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint4.dae"/>
      </geometry>
      <origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/>
    </collision>
    <inertial>
      <origin xyz="-0.05 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.0003"/>
    </inertial>
  </link>

  <link name="joint5">
    <visual>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint5.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.03356" rpy="-1.5708 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint5.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.03356" rpy="-1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <link name="joint6">
    <visual>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint6.dae"/>
      </geometry>
      <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint6.dae"/>
      </geometry>
      <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="joint6_flange">
    <visual>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint7.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mycobot_description)/urdf/mycobot_280_m5/joint7.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="g_base_to_joint1" type="fixed">
    <parent link="g_base"/>
    <child link="joint1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.9321" upper="2.9321" velocity="2.0"/>
    <parent link="joint1"/>
    <child link="joint2"/>
    <origin xyz="0 0 0.13156" rpy="0 0 0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.4434" upper="2.4434" velocity="2.0"/>
    <parent link="joint2"/>
    <child link="joint3"/>
    <origin xyz="0 0 0" rpy="0 1.5708 -1.5708"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.6179" upper="2.6179" velocity="2.0"/>
    <parent link="joint3"/>
    <child link="joint4"/>
    <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.6179" upper="2.6179" velocity="2.0"/>
    <parent link="joint4"/>
    <child link="joint5"/>
    <origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.7052" upper="2.7925" velocity="2.0"/>
    <parent link="joint5"/>
    <child link="joint6"/>
    <origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.14159" upper="3.14159" velocity="2.0"/>
    <parent link="joint6"/>
    <child link="joint6_flange"/>
    <origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint2_to_joint1">
      <command_interface name="position">
        <param name="min">-2.9321</param>
        <param name="max">2.9321</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3_to_joint2">
      <command_interface name="position">
        <param name="min">-2.4434</param>
        <param name="max">2.4434</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4_to_joint3">
      <command_interface name="position">
        <param name="min">-2.6179</param>
        <param name="max">2.6179</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5_to_joint4">
      <command_interface name="position">
        <param name="min">-2.6179</param>
        <param name="max">2.6179</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6_to_joint5">
      <command_interface name="position">
        <param name="min">-2.7052</param>
        <param name="max">2.7925</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6output_to_joint6">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <xacro:if value="$(arg adaptive_gripper)">
      <xacro:adaptive_gripper_control/>
    </xacro:if>
  </ros2_control>

  <gazebo reference="g_base">
    <turnGravityOff>true</turnGravityOff>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="joint1">
    <turnGravityOff>true</turnGravityOff>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="joint2">
    <turnGravityOff>true</turnGravityOff>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="joint3">
    <turnGravityOff>true</turnGravityOff>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="joint4">
    <turnGravityOff>true</turnGravityOff>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="joint5">
    <turnGravityOff>true</turnGravityOff>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="joint6">
    <turnGravityOff>true</turnGravityOff>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="joint6_flange">
    <turnGravityOff>true</turnGravityOff>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <xacro:if value="${'$(arg control_namespace)' != ''}">
        <ros><namespace>/$(arg control_namespace)</namespace></ros>
      </xacro:if>
      <xacro:if value="${'$(arg controller_params)' != ''}">
        <parameters>$(arg controller_params)</parameters>
      </xacro:if>
      <xacro:if value="${'$(arg controller_params)' == ''}">
      <xacro:unless value="$(arg adaptive_gripper)">
        <parameters>$(find mycobot_280_gazebo)/config/ros2_controllers.yaml</parameters>
      </xacro:unless>
      <xacro:if value="$(arg adaptive_gripper)">
        <parameters>$(find mycobot_280_gazebo)/config/ros2_controllers_gripper.yaml</parameters>
      </xacro:if>
      </xacro:if>
      <xacro:if value="${'$(arg control_namespace)' != ''}">
        <robot_param_node>/$(arg control_namespace)/robot_state_publisher</robot_param_node>
      </xacro:if>
      <xacro:if value="${'$(arg control_namespace)' == ''}">
        <robot_param_node>robot_state_publisher</robot_param_node>
      </xacro:if>
    </plugin>
  </gazebo>

</robot>
